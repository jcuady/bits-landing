# ==========================================
# BITS — Production & Vercel Environment Variables
# Copy these into your Vercel Project Settings -> Environment Variables
# ==========================================

# --------------------------------------------------------------------------
# PUBLIC SITE URL — READ THIS BEFORE YOU SET IT
# --------------------------------------------------------------------------
# site.url drives EVERY canonical link, og:url, twitter:image, sitemap entry and
# JSON-LD @id in the app (lib/site.ts). The code default is the production
# domain, so the correct action is usually to LEAVE IT UNSET.
#
# Setting it to a preview domain (e.g. a *.vercel.app hostname) repoints every
# canonical at the preview, which tells Google the real domain is not canonical.
# Only set it for a genuine, permanent alternate origin — not per-environment.
NEXT_PUBLIC_SITE_URL=https://www.boundlessits.com

# --------------------------------------------------------------------------
# SEARCH CONSOLE VERIFICATION (optional)
# --------------------------------------------------------------------------
# Each may be omitted; the meta tag is then omitted or left empty. Google has a
# working fallback token in app/layout.tsx, but set it explicitly here so the
# verification is owned by the deployment rather than by source code.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=

# --------------------------------------------------------------------------
# Supabase — BITS CRM & Auth
# --------------------------------------------------------------------------
# NEXT_PUBLIC_* values are shipped to the browser by design and are not
# secrets. The anon key is protected by Postgres RLS, which is why §29's
# finding — every policy is `using (true)` for `authenticated` — matters:
# the anon key is safe, but the authenticated role is not yet narrowed.
NEXT_PUBLIC_SUPABASE_URL=https://jvseyttzlobelrnzmfyf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NEVER ship this to the browser. It bypasses RLS entirely.
# lib/supabase/server.ts refuses to run without it rather than silently
# degrading to the anon key (the failure mode found in §16).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --------------------------------------------------------------------------
# Resend — Inbound Inquiries Email Delivery
# --------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_INBOX=boundlessitsolutions@gmail.com
# Temporary sender until custom domain is verified in Resend:
CONTACT_FROM=BITS Inquiries <onboarding@resend.dev>
# After domain is verified (e.g. bits.ph), switch to:
# CONTACT_FROM=BITS Inquiries <inquiries@bits.ph>